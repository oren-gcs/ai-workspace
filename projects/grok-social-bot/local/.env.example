# =============================================================================
# Grok Social Bot — environment template (copy to .env, never commit .env)
# =============================================================================

# --- xAI Grok (REQUIRED for bot intelligence) ---
# Create key: https://console.x.ai/
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-3

# --- Runner ---
BOT_HOST=127.0.0.1
BOT_PORT=3847
POLL_INTERVAL_MS=300000
DRY_RUN=true

# --- WhatsApp provider: meta | twilio | none ---
WHATSAPP_PROVIDER=none

# Meta WhatsApp Business Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api/
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Twilio WhatsApp (sandbox for dev)
# https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Safety gate — bot will NOT send WhatsApp unless both are set correctly
WHATSAPP_TO_NUMBER=
WHATSAPP_TEST_NUMBER=
ALLOW_OUTBOUND_WHATSAPP=false

# --- Social platforms (enable in SOCIAL_ACCOUNTS.md; stubs until OAuth done) ---
ENABLE_TWITTER=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

ENABLE_LINKEDIN=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

ENABLE_INSTAGRAM=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Webhook (incoming WhatsApp / future social callbacks)
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_SECRET=

# ngrok or public URL for Meta webhook verification (local dev only)
PUBLIC_WEBHOOK_BASE_URL=
