# =============================================================================
# Grok Social Bot — environment template (copy to .env, never commit .env)
# =============================================================================

# --- xAI Grok (REQUIRED for bot intelligence) ---
# Create key: https://console.x.ai/
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-3

# --- Runner ---
BOT_HOST=127.0.0.1
BOT_PORT=3847
POLL_INTERVAL_MS=300000
DRY_RUN=true

# --- WhatsApp provider: meta | twilio | none ---
# For Facebook/Meta unified setup use: WHATSAPP_PROVIDER=meta
WHATSAPP_PROVIDER=meta

# =============================================================================
# Meta / Facebook unified app (developers.facebook.com)
# Wizard: docs/CONFIG-META-WHATSAPP-FACEBOOK.md
# Chrome profile: oren@gcs-tech.org (work / GCS-tech)
# =============================================================================
META_APP_ID=
META_APP_SECRET=

# WhatsApp Business Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=

# Legacy aliases (still read if canonical vars empty):
# META_WHATSAPP_TOKEN, META_WHATSAPP_PHONE_NUMBER_ID,
# META_WHATSAPP_BUSINESS_ACCOUNT_ID, META_WEBHOOK_VERIFY_TOKEN

# Facebook Page (Graph API — feed + tagged mentions)
ENABLE_FACEBOOK=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Twilio WhatsApp (sandbox alternative for dev)
# https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Safety gate — bot will NOT send WhatsApp unless both are set correctly
WHATSAPP_TO_NUMBER=
WHATSAPP_TEST_NUMBER=
ALLOW_OUTBOUND_WHATSAPP=false

# --- Other social platforms (enable after OAuth) ---
ENABLE_TWITTER=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

ENABLE_LINKEDIN=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

ENABLE_INSTAGRAM=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# --- Spotify (listening activity in digest) ---
# Setup: docs/SPOTIFY-SETUP.md
ENABLE_SPOTIFY=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3847/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# Webhook (incoming WhatsApp / future social callbacks)
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_SECRET=

# ngrok or public URL for Meta webhook verification (local dev only)
# Example: https://abc123.ngrok-free.app
PUBLIC_WEBHOOK_BASE_URL=
